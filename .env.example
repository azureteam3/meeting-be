# 데이터베이스 설정
POSTGRES_URL=postgresql://user:password@localhost:5432/dbname

# Azure Speech (팀원분 기능용)
SPEECH_KEY=your_speech_subscription_key
SPEECH_REGION=koreacentral

# Azure Communication Services (소연님 기능용)
ACS_CONNECTION_STRING=your_acs_connection_string
ACS_PHONE_NUMBER=+1234567890
ACS_COGNITIVE_SERVICE_ENDPOINT=your_cognitive_service_endpoint_url